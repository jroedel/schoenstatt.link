.vagrant/
vendor/
config/development.config.php
data/cache/*
!data/cache/.gitkeep
data/form-regression/
data/port-baseline/
data/import/
data/golden/
# Material pulled down from production for analysis. Both hold third-party
# personal data — access logs carry client IP addresses, DMARC aggregate
# reports carry the sending IPs of anyone who mailed the domain — so neither
# may ever enter git history, where it could not be removed. Same reasoning as
# data/exceptions-prod/, which tools/fetch-exceptions.sh writes.
data/logs-prod/
data/dmarc/
phpunit.xml
ubuntu-xenial-16.04-cloudimg-console.log
/.buildpath
/.settings/
/.project
phploy.ini
phploy.log
.phploy
# Compiled translation catalogs, both places JTranslate writes them:
# `language/<TextDomain>/` for a domain that is not a module, and
# `module/<Module>/language/` for one that is. See
# JTranslate\Model\TranslationsTable::writePhpTranslationArrays().
#
# These are build output, not source. `bin/console jtranslate:export-catalogs`
# rebuilds them from the phrase table, and a hand edit is discarded on the next
# write — so committing them means every translation an admin saves shows up as a
# diff, and running the export once produced a ~1000-line diff of pure build output
# across four repositories.
#
# module/Schoenstatt has carried its own rule for this since before the pattern
# below existed; the JTranslate, JUser and SionModel submodules carry theirs in
# their own repositories, because a superproject .gitignore does not reach inside a
# submodule.
/language/
/module/*/language/
node_modules
.idea/
.env
tools/*.phar

# The generated sitemap. `bin/console sitemap:build` writes these into the docroot so
# Apache can serve them directly (public/.htaccess passes any existing file through before
# the rewrite to index.php); they are build output, rebuilt from the database, and the set
# of filenames grows with the catalogue. Never commit them — a committed sitemap.xml would
# be deployed over the live one and freeze it at whatever the last committer's data said.
/public/sitemap.xml
/public/sitemap-*.xml
