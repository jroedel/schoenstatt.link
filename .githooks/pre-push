#!/usr/bin/env bash
# Run the fast verification triad before a push. Opt in, per clone:
#
#   git config core.hooksPath .githooks      (or: make dev-hooks)
#
# WHY IT IS ONLY THE TRIAD: `ci-local.sh qa` is phpcs + phpstan + unit — seconds, not the
# 122s median of a full run. A hook slower than the thing it protects gets disabled, and a
# disabled hook protects nothing. The full suite stays where it belongs: before opening the
# PR, and again with --no-cache inside the deploy.
#
# WHY IT WARNS RATHER THAN BLOCKS WHEN THE CAPSULE IS DOWN: all three checks run in the
# capsule, so with Docker stopped this hook can only report that it could not look. A gate
# that fails for a reason unrelated to the code is how `--no-verify` becomes permanent, and
# a permanently bypassed hook is worse than none. ci-local.sh before the PR is the real
# gate; this only catches the break that would otherwise reach it.
#
# Deleting a branch or pushing a tag verifies nothing — there is no new code in either.
set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 0

pushing_commits=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    # An all-zero local sha is a delete.
    case "$local_sha" in
        '' | 0000000000000000000000000000000000000000) continue ;;
        *) pushing_commits=1 ;;
    esac
done

if [ "$pushing_commits" -eq 0 ]; then
    exit 0
fi

if ! curl -sf -o /dev/null http://localhost:8080/_health; then
    printf '\033[33mpre-push: the capsule is not answering, so nothing was verified.\033[0m\n' >&2
    printf 'Start it with `docker compose up -d` and run `./tools/ci-local.sh` before the PR.\n' >&2
    exit 0
fi

printf '\033[1mpre-push: ./tools/ci-local.sh qa\033[0m  (--no-verify skips this)\n'
./tools/ci-local.sh qa
status=$?

if [ "$status" -ne 0 ]; then
    printf '\n\033[31mpre-push: refused.\033[0m  ./tools/ci-local.sh --last  for the full output.\n' >&2
fi

exit "$status"
