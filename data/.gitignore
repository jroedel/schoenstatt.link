/import/
/config/*
/logs/*
/fonts/*
/musicas/
/texts/
# Generated sitemap files stay ignored, but the directory must exist or the
# sitemap route 500s (samdark/sitemap won't create it).
/sitemap/*
!/sitemap/.gitkeep
/scans/*
# Recorded exception write-ups: one directory per distinct failure, created by
# SionModel's recorder. /exceptions-prod/ is the mirror tools/fetch-exceptions.sh
# pulls off production. Both hold redacted request state — never commit either.
/exceptions/
/exceptions-prod/
