<?php
/**
 * Local Configuration Override
 *
 * This configuration override file is for overriding environment-specific and
 * security-sensitive configuration information. Copy this file without the
 * .dist extension at the end and populate values as needed.
 *
 * @NOTE: This file is ignored from Git by default with the .gitignore included
 * in ZendSkeletonApplication. This is a good practice, as it prevents sensitive
 * credentials from accidentally being committed into version control.
 */

$smtpOptions = [
    /**
     * The SMTP authentication identity.
     * If this is not set, the 'from' option of the message will be used.
     *
     * Default value is an empty string
     */
    'username' => 'webmaster@schoenstatt.link',

    /**
     * The SMTP authentication credential.
     *
     * Default value is an empty string
     */
    'password' => 'xxxxxxxxxxxxx',

    /**
     * This defines the encryption type to be used, 'ssl' or 'tls'.
     * Null should be used to disable SSL.
     *
     * Default value is null
     */
    'ssl'   => 'tls',
    'port'  => 587,
    'server' => 'mail.your-server.de',
];

return [
    'db' => [
        'driver'         => 'pdo_mysql',
        'hostname'      => 'localhost',
        'database'      => 'xxxxxxxxxx',
        'username'       => 'root',
        'password'       => 'xxxxxxxxx',
        //PHP 8.5 deprecates PDO::MYSQL_ATTR_INIT_COMMAND in favour of
        //Pdo\Mysql::ATTR_INIT_COMMAND, which does not exist before 8.4. Both
        //spellings are the same integer; the check only avoids emitting a
        //deprecation. Note the *live* local.php on each machine and on the
        //server carries its own copy of this line and has to be updated
        //separately — see docs/BACKLOG.md.
        //
        //utf8mb4, not UTF8: in MariaDB `utf8` means `utf8mb3`, so 'SET NAMES UTF8'
        //opens a 3-byte connection and the server silently degrades anything
        //outside the BMP to `?` when reading from the utf8mb4 tables that
        //database/db7.0.sql creates. THIS IS THE LINE THAT HAS TO CHANGE ON THE
        //SERVER TOO — config/autoload/local.php is gitignored, so deploying this
        //.dist file changes nothing in production by itself.
        'driver_options' => [
            (class_exists('Pdo\Mysql') ? \Pdo\Mysql::ATTR_INIT_COMMAND : \PDO::MYSQL_ATTR_INIT_COMMAND)
                => 'SET NAMES utf8mb4;',
        ],
    ],
    /**
     * Keep both of these false on a public server: they render the exception
     * message, the file path and the full stack trace into the error page for
     * anyone who can provoke a 500, authenticated or not.
     *
     * There must be exactly ONE view_manager key in this file. A second one
     * further down used to silently replace this whole block — that is how a
     * production install ended up displaying stack traces while this block said
     * otherwise, and how display_not_found_reason quietly came back to its
     * default. PHP keeps the last of two duplicate keys in an array literal and
     * says nothing.
     */
    'view_manager' => [
        'display_not_found_reason' => false,
        'display_exceptions'       => false,
    ],
    'sion_model' => [
        'api_keys' => ['xxxxxxxxxxxxxxxxxxxxxx'],
    ],
    'books' => [
        'files_api_key' => 'xxxxxxxxxxxxxx',
        'files_api_url' => 'https://script.google.com/macros/s/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx/exec',
    ],
    'schoenstatt' => [
        'api_keys' => [
            'xxxxxxxxxxxxxxxxxxxxx',
        ],
        'patres_api_key' => 'xxxxxxxxxxxxxxxxxxxxxxxx',
        'patres_api_person_list_uri' => 'https://schoenstatt-fathers.link/api/persons',
        'patres_api_get_person_uri' => 'https://schoenstatt-fathers.link/api/persons/%s',
    ],
    'recaptcha' => [
        'name' => 'recaptcha',
        'privKey' => 'xxxxxxxxxxxxxx',
        'pubKey' => 'xxxxxxxxxxxxxxx',
    ],
    'smtp_options' => $smtpOptions,
    'session_config' => [
        'cookie_secure' => true,
        'cookie_http_only' => true,
    ],
    'ApiRequest' => [
        'jwtAuth' => [
            'cypherKey' => 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx',
        ],
    ],
];
