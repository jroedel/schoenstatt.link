{
    "name": "jroedel/schoenstatt.link",
    "description": "Database application for Schoenstatt-related topics",
    "license": "BSD-3-Clause",
    "keywords": [
        "framework",
        "zf2",
        "mvc",
        "translation"
    ],
    "homepage": "http://framework.zend.com/",
    "require": {
        "php": ">=5.6",
        "nesbot/carbon": "^1.28",
        "giggsey/libphonenumber-for-php": "^8.9",
        "neitanod/forceutf8": "^2.0",
        "tedivm/jshrink": "^1.1",
        "voku/html2text": "^3.4",
        "tijsverkoyen/css-to-inline-styles": "^2.2",
        "neilime/zf2-twb-bundle": "^3.0",
        "maglnet/magl-markdown": "~1.1",
        "zfc-datagrid/zfc-datagrid": "^1.4",
        "phpoffice/phpexcel": "^1.8",
    	"neilime/zf2-mobile-detect": "^2.2",
        "kokspflanze/bjy-authorize": "dev-master",
    	"goalio/goalio-rememberme": "dev-master",
        "zf-commons/zfc-user": "^3.0",
        "matriphe/iso-639": "^1.0",
		"cakephp/utility": "^3.2.0",
        "mledoze/countries": "^1.8",
        "spatie/schema-org": "^1.6",
        "slm/locale": "^0.3",
        "zendframework/zend-component-installer": "^1.0",
        "zendframework/zend-permissions-acl": "^2.7",
        "zendframework/zend-navigation": "^2.9",
        "zendframework/zend-authentication": "^2.6",
        "roave/security-advisories": "dev-master",
        "zendframework/zend-mvc-form": "^1.0",
        "jroedel/zf-snap-geoip": "^3.0",
        "ocramius/proxy-manager": "^2.1"
    },
    "require-dev": {
        "bjyoungblood/bjy-profiler": "^1.1",
        "zendframework/zend-developer-tools": "^1.1"
    },
	"repositories": [
	   {
	     "type": "vcs",
	     "url": "https://github.com/basz/SlmLocale"
	   },
	   {
	     "type": "vcs",
	     "url": "https://github.com/kokspflanze/BjyAuthorize"
	   },
	   {
	     "type": "vcs",
	     "url": "https://github.com/jroedel/GoalioRememberMe"
	   },
	   {
	     "type": "vcs",
	     "url": "https://github.com/jroedel/ZfSnapGeoip"
	   }
	],
	"autoload": {
    	"psr-4": {
        	"Application\\": "module/Application/src/",
        	"Bible\\": "module/Bible/src/",
        	"Books\\": "module/Books/src/",
        	"JTranslate\\": "module/JTranslate/src/",
        	"JUser\\": "module/JUser/src/",
        	"Schoenstatt\\": "module/Schoenstatt/src/",
        	"SionModel\\": "module/SionModel/src/"
    	}
	}
}
