{
    "name": "jroedel/schoenstatt.link",
    "description": "Database application for Schoenstatt-related topics",
    "license": "BSD-3-Clause",
    "keywords": [
        "framework",
        "zf3",
        "mvc",
        "translation",
        "schoenstatt"
    ],
    "homepage": "http://framework.zend.com/",
    "require": {
        "php": "~8.3.0",
        "nesbot/carbon": "^2.62",
        "giggsey/libphonenumber-for-php": "^8.11",
        "neitanod/forceutf8": "^2.0",
        "tedivm/jshrink": "^1.1",
        "voku/html2text": "^5.0",
        "tijsverkoyen/css-to-inline-styles": "^2.2",
        "diablomedia/laminas-twb-bundle": "^5.0",
        "phpoffice/phpexcel": "^1.8",
        "kokspflanze/bjy-authorize": "^2.4",
        "matriphe/iso-639": "^1.0",
        "spatie/schema-org": "^4.0",
        "slm/locale": "^1.2",
        "laminas/laminas-permissions-acl": "^2.7",
        "laminas/laminas-navigation": "^2.9",
        "laminas/laminas-authentication": "^2.6",
        "laminas/laminas-json": "^3.1",
        "laminas/laminas-mail": "^2.10",
        "laminas/laminas-i18n": "^2.33",
        "laminas/laminas-mvc": "^3.8",
        "laminas/laminas-mvc-plugin-identity": "^1.1",
        "laminas/laminas-mvc-i18n": "^1.1",
        "laminas/laminas-captcha": "^2.8",
        "laminas/laminas-text": "^2.7",
        "laminas/laminas-mvc-plugin-prg": "^1.1",
        "swiftmailer/swiftmailer": "^6.0",
        "cocur/slugify": "^3.1",
        "erusev/parsedown": "~1.7.4",
        "erusev/parsedown-extra": "^0.8.1",
        "firebase/php-jwt": "^6.0",
        "spatie/opening-hours": "^2.0",
        "jmikola/geojson": "1.0",
        "scottconnerly/timezone": "^0.2.0",
        "nicolaswurtz/chordpro-php": "dev-master",
        "samdark/sitemap": "^2.2",
        "lib-icu": ">=4.4",
        "ext-intl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "laminas/laminas-form": "^3.24",
        "laminas/laminas-log": "^2.17",
        "laminas/laminas-serializer": "^2.17",
        "laminas/laminas-cache-storage-adapter-apcu": "^2.5",
        "laminas/laminas-cache-storage-adapter-filesystem": "^2.5",
        "laminas/laminas-cache-storage-adapter-memory": "^2.3",
        "laminas/laminas-router": "^3.3",
        "laminas/laminas-db": "^2.11",
        "laminas/laminas-mvc-plugin-flashmessenger": "^1.2",
        "laminas/laminas-crypt": "^3.3"
    },
    "require-dev": {
        "laminas/laminas-developer-tools": "^2.10",
        "squizlabs/php_codesniffer": "^3.3"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/jroedel/chordpro-php",
            "no-api": true
        }
    ],
    "config": {
        "platform": {
            "php": "8.3.33",
            "ext-intl": "8.3.33",
            "ext-pdo": "8.3.33",
            "ext-pdo_mysql": "8.3.33",
            "ext-dom": "8.3.33",
            "ext-simplexml": "8.3.33",
            "ext-xmlwriter": "8.3.33",
            "ext-gd": "8.3.33",
            "lib-icu": "76.1",
            "ext-apcu": "5.1.24",
            "ext-xml": "8.3.33",
            "ext-mbstring": "8.3.33"
        },
        "audit": {
            "abandoned": "report"
        },
        "policy": {
            "advisories": {
                "ignore": {
                    "phpoffice/phpexcel": "abandoned; migration to phpoffice/phpspreadsheet is planned in the Phase 3 ladder (BACKLOG.md)"
                },
                "ignore-id": {
                    "PKSA-y2cr-5h3j-g3ys": "php-jwt <7 weak-encryption advisory (CVE-2025-45769); v7 requires PHP >=8.0 — upgrade at the PHP 8 rung of the Phase 3 ladder. v6.11 does fix the critical CVE-2021-46743."
                }
            }
        },
        "allow-plugins": {}
    },
    "autoload": {
        "psr-4": {
            "Application\\": "module/Application/src/",
            "Bible\\": "module/Bible/src/",
            "Books\\": "module/Books/src/",
            "JTranslate\\": "module/JTranslate/src/",
            "JUser\\": "module/JUser/src/",
            "RestApi\\": "module/RestApi/src/",
            "Schoenstatt\\": "module/Schoenstatt/src/",
            "SionModel\\": "module/SionModel/src/"
        }
    },
    "scripts": {
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "serve": "php -S 127.0.0.1:8080 -t public",
        "smoke": "docker compose exec -T app php tools/phpunit.phar --testsuite smoke",
        "unit": "docker compose exec -T app php tools/phpunit.phar --testsuite unit",
        "test": "docker compose exec -T app php tools/phpunit.phar"
    },
    "scripts-descriptions": {
        "smoke": "Run the HTTP smoke suite against the running capsule. ONE process at a time — never fan this out in parallel."
    }
}
