final class CtxIndex
{
    /** @var list<array<string, mixed>> */
    private array $decls = [];

    /** @param array<string, array{mtime: int, size: int, decls: list<array<string, mixed>>}> $files */
    public function __construct(private array $files)
    {
        foreach ($files as $file => $entry) {
            foreach ($entry['decls'] as $decl) {
                $decl['file'] = $file;
                $this->decls[] = $decl;
            }
        }
    }

    public function fileCount(): int
    {
        return count($this->files);
    }

    public function declCount(): int
    {
        return count($this->decls);
    }

    /** @return list<array<string, mixed>> */
    public function forFile(string $file): array
    {
        return array_values(array_filter($this->decls, static fn(array $d): bool => $d['file'] === $file));
    }

    /**
     * Resolve a symbol, most specific match first. `Foo\Bar::baz`, `Bar::baz`, `Bar`,
     * `baz` all work; an ambiguous short name returns every candidate rather than
     * guessing, because guessing is what this tool exists to stop.
     *
     * @return list<array<string, mixed>>
     */
    public function resolve(string $symbol): array
    {
        $symbol = ltrim(str_replace('/', '\\', $symbol), '\\');
        $symbol = rtrim($symbol, '()');

        $exact = $this->where(static fn(array $d): bool => strcasecmp((string) $d['key'], $symbol) === 0);
        if ($exact !== []) {
            return $exact;
        }

        if (str_contains($symbol, '::')) {
            [$owner, $member] = explode('::', $symbol, 2);
            $short = $this->shortName($owner);

            return $this->where(static fn(array $d): bool => $d['owner'] !== null
                && strcasecmp((string) $d['name'], $member) === 0
                && strcasecmp(self::tail((string) $d['owner']), $short) === 0);
        }

        $byFqn = $this->where(static fn(array $d): bool => $d['owner'] === null
            && strcasecmp((string) $d['name'], self::tail($symbol)) === 0
            && str_ends_with(strtolower((string) $d['key']), strtolower($symbol)));
        if ($byFqn !== []) {
            return $byFqn;
        }

        return $this->where(static fn(array $d): bool => strcasecmp((string) $d['name'], $symbol) === 0);
    }

    /**
     * The innermost declaration containing a line, as a printable region.
     *
     * @return array{int, int, string}|null
     */
    public function enclosing(string $file, int $line): ?array
    {
        $best = null;
        foreach ($this->forFile($file) as $d) {
            if ($d['line'] > $line || $d['end'] < $line) {
                continue;
            }
            if ((int) $d['end'] - (int) $d['line'] > CTX_ENCLOSING_MAX_LINES) {
                continue;
            }
            if ($best === null || ($d['end'] - $d['line']) < ($best['end'] - $best['line'])) {
                $best = $d;
            }
        }

        return $best === null ? null : [(int) $best['line'], (int) $best['end'], (string) $best['sig']];
    }

    /**
     * @param  callable(array<string, mixed>): bool $predicate
     * @return list<array<string, mixed>>
     */
    private function where(callable $predicate): array
    {
        return array_values(array_filter($this->decls, $predicate));
    }

    private function shortName(string $name): string
    {
        return self::tail($name);
    }

    private static function tail(string $name): string
    {
        $pos = strrpos($name, '\\');

        return $pos === false ? $name : substr($name, $pos + 1);
    }
}

// -----------------------------------------------------------------------------------

final class CtxParser
{
    /**
     * Exact bounds, by construction: getStartLine()/getEndLine() come from the token
     * positions, not from counting braces.
     *
     * @return list<array<string, mixed>>
     */
    public static function declarations(string $file): array
    {
        $code = @file_get_contents($file);
        if ($code === false) {
            return [];
        }

        $parser = (new PhpParser\ParserFactory())->createForNewestSupportedVersion();

        try {
            $ast = $parser->parse($code);
        } catch (PhpParser\Error) {
            // An unparseable file is a fact about the file, not a reason to fail the
            // whole index — the legacy tree still holds a few.
            return [];
        }

        if ($ast === null) {
            return [];
        }

        $visitor = new CtxVisitor();
        $traverser = new PhpParser\NodeTraverser();
        $traverser->addVisitor(new PhpParser\NodeVisitor\NameResolver());
        $traverser->addVisitor($visitor);
        $traverser->traverse($ast);

        return $visitor->declarations;
    }
}

final class CtxVisitor extends PhpParser\NodeVisitorAbstract
{
    /** @var list<array<string, mixed>> */
    public array $declarations = [];

    private PhpParser\PrettyPrinter\Standard $printer;

    /** @var list<string> */
    private array $stack = [];

    public function __construct()
    {
        $this->printer = new PhpParser\PrettyPrinter\Standard();
    }

    public function enterNode(PhpParser\Node $node): null
    {
        $isType = $node instanceof PhpParser\Node\Stmt\Class_
            || $node instanceof PhpParser\Node\Stmt\Interface_
            || $node instanceof PhpParser\Node\Stmt\Trait_
            || $node instanceof PhpParser\Node\Stmt\Enum_;

        if ($isType) {
            // An anonymous class has no name and nothing can look it up by one.
            $name = $node->namespacedName ?? null;
            if ($name === null) {
                return null;
            }
            $fqn = $name->toString();
            $this->stack[] = $fqn;
            $this->record($node, self::tail($fqn), $fqn, null);

            return null;
        }

        if ($node instanceof PhpParser\Node\Stmt\Function_) {
            $fqn = $node->namespacedName?->toString() ?? $node->name->toString();
            $this->record($node, $node->name->toString(), $fqn, null);

            return null;
        }

        if ($node instanceof PhpParser\Node\Stmt\ClassMethod) {
            $owner = end($this->stack);
            if ($owner === false) {
                return null;
            }
            $this->record($node, $node->name->toString(), $owner . '::' . $node->name->toString(), $owner);
        }

        return null;
    }

    public function leaveNode(PhpParser\Node $node): null
    {
        $isType = $node instanceof PhpParser\Node\Stmt\Class_
            || $node instanceof PhpParser\Node\Stmt\Interface_
            || $node instanceof PhpParser\Node\Stmt\Trait_
            || $node instanceof PhpParser\Node\Stmt\Enum_;

        if ($isType && ($node->namespacedName ?? null) !== null) {
            array_pop($this->stack);
        }

        return null;
    }

    private function record(PhpParser\Node\Stmt $node, string $name, string $key, ?string $owner): void
    {
        // The region starts at the doc comment, not at the `function` keyword. A search
        // hit on `@param bool $objectsAreEveryAssociation` is a hit on the method that
        // documents it; without this it resolves to the enclosing class instead, and
        // "expand to the enclosing declaration" prints three thousand lines.
        $start = $node->getDocComment()?->getStartLine() ?? $node->getStartLine();

        $this->declarations[] = [
            'name'  => $name,
            'key'   => $key,
            'owner' => $owner,
            'line'  => $start,
            'end'   => $node->getEndLine(),
            'sig'   => $this->signature($node),
        ];
    }

    /**
     * The declaration header, printed from the AST rather than sliced out of the source,
     * so a multi-line parameter list collapses to one accurate line.
     */
    private function signature(PhpParser\Node\Stmt $node): string
    {
        $clone = clone $node;
        $clone->setAttribute('comments', []);
        if (property_exists($clone, 'stmts')) {
            $clone->stmts = [];
        }
        if (property_exists($clone, 'attrGroups')) {
            $clone->attrGroups = [];
        }

        $printed = $this->printer->prettyPrint([$clone]);
        $first = strtok($printed, "\n");
        $signature = $first === false ? '' : $first;

        return rtrim(trim($signature), '{');
    }

    private static function tail(string $name): string
    {
        $pos = strrpos($name, '\\');

        return $pos === false ? $name : substr($name, $pos + 1);
    }
}

// -----------------------------------------------------------------------------------

/** @var list<string> $arguments */
$arguments = $_SERVER['argv'];

exit((new CtxCommand($root))->run(array_slice($arguments, 1)));
