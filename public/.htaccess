Options +FollowSymLinks -Indexes
RewriteEngine On

# Auto-upgrade connection to HTTPS
RewriteCond %{HTTP_HOST} ^(www\.)?schoenstatt\.link [NC]
RewriteCond %{SERVER_PORT} 80
RewriteRule ^(.*)$ https://schoenstatt\.link/$1 [R=301,L]

# Make sure we don't use www as they don't share cookies
RewriteCond %{HTTP_HOST} ^www\.schoenstatt\.link [NC]
RewriteCond %{SERVER_PORT} 443
RewriteRule ^(.*)$ https://schoenstatt\.link/$1 [R=301,L]

# Tell PHP (FastCGI) it's behind HTTPS; the app relies on $_SERVER['HTTPS']
# for URL generation. Host-conditional so the Docker capsule (plain HTTP on
# localhost:8080) doesn't generate unreachable https:// URLs.
SetEnvIf Host "schoenstatt\.link$" HTTPS=on

# HSTS for 2 years, preloaded (removal from the preload list takes months —
# treat includeSubDomains as a permanent commitment). Browsers ignore the
# header on plain-HTTP responses, so sending it unconditionally is safe.
Header set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

# protect against non-scripts being run
Header set X-Content-Type-Options nosniff

# old X frame support, we don't use iframes
Header set X-Frame-Options DENY

# set Referrer policy
Header set Referrer-Policy "strict-origin-when-cross-origin"

#ZF2 rewrite
RewriteCond %{REQUEST_FILENAME} -s [OR]
RewriteCond %{REQUEST_FILENAME} -l [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^.*$ - [L]

# The following rewrites all other queries to index.php. The
# condition ensures that if you are using Apache aliases to do
# mass virtual hosting, the base path will be prepended to
# allow proper resolution of the index.php file; it will work
# in non-aliased environments as well, providing a safe, one-size
# fits all solution.
RewriteCond %{REQUEST_URI}::$1 ^(/.+)(.+)::\2$
RewriteRule ^(.*) - [E=BASE:%1]
RewriteRule ^(.*)$ %{ENV:BASE}index.php [L]
SetEnv "APP_ENV" "production"

# Symfony-kernel canary — see docs/strangler.md.
#
# Absent by default, so every visitor keeps getting Laminas\Mvc\Application
# exactly as they always have. A request carrying this cookie gets App\Kernel
# instead, which is how the ported routes get exercised against production's real
# data, real ICU and real session store without a window where all traffic is on
# them.
#
# **Not a secret and not a security boundary.** It is an opt-in toggle anyone can
# set, and that is safe because both front controllers enforce the *same* ACL:
# App\Authorization\RouteGuard asks about the same `route/<name>` resources
# BjyAuthorize\Guard\Route does, from the same config, so an opted-in visitor
# reaches nothing they could not already reach. If it ever stops being true that
# the two agree, this line is not what protects you — docs/acl-rules.md is.
#
# **Do not add `SetEnv SYMFONY_KERNEL 0` beside this** to make the default
# explicit. mod_env runs *after* mod_setenvif, so a SetEnv wins over this line
# regardless of the order they appear in, and the canary silently stops working.
# Measured 2026-08-08, after exactly that mistake.
SetEnvIf Cookie "sl_symfony_canary=1" SYMFONY_KERNEL=1

# compress text, html, javascript, css, xml, json:
<IfModule deflate_module>
    # Enable compression for the following file types.
    AddOutputFilterByType            \
     DEFLATE                         \
      application/javascript         \
      application/json               \
      application/xml                \
      image/svg+xml                  \
      text/css                       \
      text/html                      \
      text/javascript                \
      text/plain                     \
      text/xml
</IfModule>

# One year for images and fonts (immutable: these never change in place)
<FilesMatch "\.(jpe?g|png|gif|ico|svg|webp|avif|flv|woff2?)$">
Header set Cache-Control "max-age=31536000, public, immutable"
</FilesMatch>

# One month for css and js (no filename versioning yet, so keep it modest)
<FilesMatch "\.(css|js)$">
Header set Cache-Control "max-age=2628000, public"
</FilesMatch>

#Only cache css for 1 day
<Files gen-basic.css>
Header set Cache-Control "public,max-age=86400"
</Files>
