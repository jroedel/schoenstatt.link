Options +FollowSymLinks -Indexes
RewriteEngine On

# Auto-upgrade connection to HTTPS
RewriteCond %{HTTP_HOST} ^(www\.)?schoenstatt\.link [NC]
RewriteCond %{SERVER_PORT} 80
RewriteRule ^(.*)$ https://schoenstatt\.link/$1 [R=301,L]

# Make sure we don't use www as they don't share cookies
RewriteCond %{HTTP_HOST} ^www\.schoenstatt\.link [NC]
RewriteCond %{SERVER_PORT} 443
RewriteRule ^(.*)$ https://schoenstatt\.link/$1 [R=301,L]

# Tell PHP (FastCGI) it's behind HTTPS; the app relies on $_SERVER['HTTPS']
# for URL generation. Host-conditional so the Docker capsule (plain HTTP on
# localhost:8080) doesn't generate unreachable https:// URLs.
SetEnvIf Host "schoenstatt\.link$" HTTPS=on

# HSTS for 2 years, preloaded (removal from the preload list takes months —
# treat includeSubDomains as a permanent commitment). Browsers ignore the
# header on plain-HTTP responses, so sending it unconditionally is safe.
Header set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

# protect against non-scripts being run
Header set X-Content-Type-Options nosniff

# old X frame support, we don't use iframes
Header set X-Frame-Options DENY

# set Referrer policy
Header set Referrer-Policy "strict-origin-when-cross-origin"

#ZF2 rewrite
RewriteCond %{REQUEST_FILENAME} -s [OR]
RewriteCond %{REQUEST_FILENAME} -l [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^.*$ - [L]

# The following rewrites all other queries to index.php. The
# condition ensures that if you are using Apache aliases to do
# mass virtual hosting, the base path will be prepended to
# allow proper resolution of the index.php file; it will work
# in non-aliased environments as well, providing a safe, one-size
# fits all solution.
RewriteCond %{REQUEST_URI}::$1 ^(/.+)(.+)::\2$
RewriteRule ^(.*) - [E=BASE:%1]
RewriteRule ^(.*)$ %{ENV:BASE}index.php [L]
SetEnv "APP_ENV" "production"

# ---------------------------------------------------------------------------
# Which front controller serves this request — see docs/strangler.md.
#
# public/index.php branches on SYMFONY_KERNEL: unset or "0" is the
# Laminas\Mvc\Application entry point that has always been here, "1" is
# App\Kernel with a catch-all route bridging every unported path back to it.
#
# Three rules govern this block, each of them measured rather than assumed:
#
# 1. **The site-wide default comes first, the per-visitor overrides after it.**
#    mod_setenvif evaluates its directives top to bottom and the *last* match
#    wins. Put an override above the default and the default silently overwrites
#    it — the cookie is then dead with no symptom at all. Probed 2026-08-09: with
#    the order reversed, a request carrying sl_symfony_canary=0 still came out
#    with SYMFONY_KERNEL=1.
#
# 2. **Never express the default with `SetEnv`.** mod_env runs *after* the whole
#    of mod_setenvif, so a `SetEnv SYMFONY_KERNEL` beats every line here whatever
#    the file order, and both cookies stop working. Measured 2026-08-08, after
#    exactly that mistake. test/Integration/KernelCanaryTest fails on it.
#
# 3. **Neither cookie is a secret or a security boundary.** Anyone can set
#    either, and that is safe because both front controllers enforce the *same*
#    ACL: App\Authorization\RouteGuard asks about the same `route/<name>`
#    resources BjyAuthorize\Guard\Route does, from the same config, so an
#    opted-in visitor reaches nothing they could not already reach. If that ever
#    stops being true, these lines are not what protects you — docs/acl-rules.md
#    is.
#
# THE GLOBAL FLIP, done. Every visitor and every automated agent — which sends no
# cookie — reaches App\Kernel from here on; the two overrides below still let one
# visitor choose either kernel for themselves.
#
# This line must stay **above** both overrides and must stay a SetEnvIf. Below
# them it silently overwrites them (mod_setenvif takes the last match); as a
# SetEnv it beats them whatever the order, because mod_env runs after all of
# mod_setenvif. Both mistakes have been made here and both are invisible in
# testing — test/Integration/KernelCanaryTest is what catches them.
#
# docs/DEPLOY.md holds the before/after checklists and the three rollbacks. The
# cheap one is deleting this single line on the server, which takes effect on the
# next request and lasts until the next deploy overwrites it; the durable one is
# reverting the commit that added it, which is why that commit touches nothing
# else.
SetEnvIf Request_URI ".*" SYMFONY_KERNEL=1

# Opt *in* to App\Kernel for one visitor. Redundant for ordinary traffic now that
# the default above says the same thing, and kept because it is what pins an
# administrator to the new kernel even while an incident has the default rolled
# back — the rollback that deletes one line on the server leaves this one standing.
SetEnvIf Cookie "sl_symfony_canary=1" SYMFONY_KERNEL=1

# Opt back *out* to laminas-mvc for one visitor. This is now the important one: it
# is the per-visitor escape hatch, and it was deployed ahead of the flip
# deliberately so that it had been exercised before it was the only one left.
# Administrators reach both through the **Switch kernel** navbar item, which
# offers whichever kernel they are not on.
SetEnvIf Cookie "sl_symfony_canary=0" SYMFONY_KERNEL=0
# ---------------------------------------------------------------------------

# compress text, html, javascript, css, xml, json:
<IfModule deflate_module>
    # Enable compression for the following file types.
    AddOutputFilterByType            \
     DEFLATE                         \
      application/javascript         \
      application/json               \
      application/xml                \
      image/svg+xml                  \
      text/css                       \
      text/html                      \
      text/javascript                \
      text/plain                     \
      text/xml
</IfModule>

# One year for images and fonts (immutable: these never change in place)
<FilesMatch "\.(jpe?g|png|gif|ico|svg|webp|avif|flv|woff2?)$">
Header set Cache-Control "max-age=31536000, public, immutable"
</FilesMatch>

# One month for css and js (no filename versioning yet, so keep it modest)
<FilesMatch "\.(css|js)$">
Header set Cache-Control "max-age=2628000, public"
</FilesMatch>

#Only cache css for 1 day
<Files gen-basic.css>
Header set Cache-Control "public,max-age=86400"
</Files>
