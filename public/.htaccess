Options +FollowSymLinks
RewriteEngine On

# Auto-upgrade connection to HTTPS
RewriteCond %{HTTP_HOST} ^(www\.)?schoenstatt\.link [NC]
RewriteCond %{SERVER_PORT} 80 
RewriteRule ^(.*)$ https://schoenstatt\.link/$1 [R=301,L]

# Make sure we don't use www as they don't share cookies
RewriteCond %{HTTP_HOST} ^www\.schoenstatt\.link [NC]
RewriteCond %{SERVER_PORT} 443
RewriteRule ^(.*)$ https://schoenstatt\.link/$1 [R=301,L]

# Enable HSTS for 6 months, preload into Chrome
SetEnv HTTPS on
Header set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" env=HTTPS

# protect against non-scripts being run
Header add X-Content-Type-Options nosniff

# old X frame support, we don't use iframes
Header add X-Frame-Options DENY

# XSS protection in IE and Chrome
Header add X-XSS-Protection "1; mode=block"

# set Referrer policy
Header add Referrer-Policy "no-referrer, strict-origin-when-cross-origin"

#ZF2 rewrite
RewriteCond %{REQUEST_FILENAME} -s [OR]
RewriteCond %{REQUEST_FILENAME} -l [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^.*$ - [NC,L]

# The following rewrites all other queries to index.php. The 
# condition ensures that if you are using Apache aliases to do
# mass virtual hosting, the base path will be prepended to 
# allow proper resolution of the index.php file; it will work
# in non-aliased environments as well, providing a safe, one-size 
# fits all solution.
RewriteCond %{REQUEST_URI}::$1 ^(/.+)(.+)::\2$
RewriteRule ^(.*) - [E=BASE:%1]
RewriteRule ^(.*)$ %{ENV:BASE}index.php [NC,L]
SetEnv "APP_ENV" "production"

# compress text, html, javascript, css, xml:
<IfModule deflate_module>
    # Enable compression for the following file types.
    AddOutputFilterByType            \
     DEFLATE                         \
      application/javascript         \
      image/svg+xml                  \
      text/css                       \
      text/html                      \
      text/javascript                \
      text/plain                     \
      text/xml
</IfModule>

# One year for image files
<filesMatch ".(jpg|jpeg|png|gif|ico|svg|flv)$">
Header set Cache-Control "max-age=31536000, public, only-if-cached"
</filesMatch>

# One month for css and js
<filesMatch ".(css|js)$">
Header set Cache-Control "max-age=2628000, public, only-if-cached"
</filesMatch>

#Only cache css for 1 day
<Files gen-basic.css>
Header unset Cache-Control
Header set Cache-Control "public,max-age=86400"
</Files>


#ExpiresActive On
#ExpiresByType image/svg+xml A2592000
