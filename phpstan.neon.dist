includes:
    - phpstan-baseline.neon

# Static analysis for the legacy baseline. Level is deliberately low and all
# pre-existing errors live in phpstan-baseline.neon: the contract is "no NEW
# errors", not "the legacy code is clean". Raise the level as modernization
# proceeds. Run inside the docker app container:
#   docker compose exec -T app php -d memory_limit=1G tools/phpstan.phar analyse
parameters:
    level: 0
    # Must track the platform, not history: PHPStan parses vendor/ with this
    # setting, so leaving it on 7.4 after the rung-4b flip made it choke on
    # PHP-8 syntax throughout the laminas tree and report ~437 phantom
    # "class not found" errors. Keep in step with config.platform.php.
    phpVersion: 80400
    paths:
        - src
        - module/Application/src
        - module/Books/src
        - module/JTranslate/src
        - module/JUser/src
        - module/Schoenstatt/src
        - module/SionModel/src
    bootstrapFiles:
        - vendor/autoload.php
    # Stays false, and not out of laziness: `src/` and `config/symfony` hold themselves
    # to level 8 while the committed level here is 0, so every suppression written for a
    # level-8 finding — the three EntityShow entries below, the inline `@phpstan-ignore`
    # in DictionaryController and LiteratureController — legitimately matches nothing at
    # level 0. Turning this on reports all of them as unmatched, which is noise, not rot.
    #
    # The cost is that a baseline entry whose CODE gets deleted also goes unreported, and
    # two had: `Function issett not found` in PublicationsTable outlived the importer that
    # contained it, and the SionForm entry claimed `count: 3` where only 1 occurrence is
    # left. Both fixed 2026-08-14. To audit for more, run deliberately with the flag on
    # and read past the level-8 entries:
    #
    #   sed 's/reportUnmatchedIgnoredErrors: false/reportUnmatchedIgnoredErrors: true/' \
    #     phpstan.neon.dist > phpstan-unmatched.neon
    #   docker compose exec -T app php -d memory_limit=1G tools/phpstan.phar \
    #     analyse -c phpstan-unmatched.neon --no-progress
    #
    # A "No error with identifier … is reported" line for a file under src/ is expected;
    # an unmatched *baseline* pattern is a stale entry.
    reportUnmatchedIgnoredErrors: false
    # Runtime guards that PHPStan calls redundant because it believes a docblock in
    # the vendored SionModel library. They only surface at level 8 (the standard
    # `src/` holds itself to; the committed level is 0), and each one is a check that
    # would be wrong to delete:
    #
    #  - `SionTable::existsEntity()` is annotated `@return boolean` and PHPStan infers
    #    `true`, so `if (! $table->existsEntity(...))` reads as dead code. The method
    #    plainly `return false`s when the gateway finds no row, and dropping the guard
    #    would turn a missing entity into a fatal on the next line.
    #  - `Entity::$aclShowPermission` is annotated `@var string` and is null for every
    #    entity that does not declare `acl_show_permission` — which is three of this
    #    batch's four.
    #
    # The real fix is to correct those annotations in SionModel, which is a change of
    # its own with its own review. Scoped to the two files rather than
    # turned off globally via treatPhpDocTypesAsCertain, so the next wrong annotation
    # is still reported.
    #
    # EntityEdit briefly needed the same suppression and no longer does: its
    # deniedMessage() asked existsEntity() to choose between "not found" and "access
    # denied", which the batch-7 baseline showed was the wrong question — editAction()
    # branches on getObject() being null — so the call went away and the ignore with it.
    ignoreErrors:
        -
            identifier: booleanNot.alwaysFalse
            path: src/Sion/EntityShow.php
        -
            identifier: ternary.alwaysTrue
            path: src/Sion/EntityShow.php
        -
            identifier: booleanAnd.alwaysTrue
            path: src/Sion/EntityShow.php
