<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.5/phpunit.xsd"
         bootstrap="test/bootstrap.php"
         colors="true"
         failOnWarning="true"
         cacheDirectory="data/cache/.phpunit.cache"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerNotices="true">
  <testsuites>
    <testsuite name="smoke">
      <directory>test/Smoke</directory>
    </testsuite>
    <!-- Unit tests need no running app and no vendor/: each test requires
             the class under test directly. They run on the host PHP as well as
             in the capsule. -->
    <testsuite name="unit">
      <directory>test/Unit</directory>
    </testsuite>
    <!-- Integration tests exercise real vendor/ libraries (no running app,
             no DB). They require vendor/autoload.php themselves, so they only
             run where composer install has happened — i.e. the capsule. -->
    <testsuite name="integration">
      <directory>test/Integration</directory>
    </testsuite>
    <!-- Form input-validation fuzz harness. Builds every form through the real
             service container (no MVC bootstrap, no HTTP) and drives a hostile
             corpus through it, plus static checks over each form's input filter
             wiring. Needs vendor/ and the capsule's database — read-only; the
             suite proves that from the adapter's statement log. Findings are
             baselined in test/Fuzz/known-form-gaps.php, contract "no new gaps":
             docker compose exec -T app php test/Fuzz/regenerate-baseline.php -->
    <testsuite name="fuzz">
      <directory>test/Fuzz</directory>
    </testsuite>
  </testsuites>
  <php>
    <!-- Base URL of the running app. Inside the docker app container the
             site is served on port 80, so the default works via:
             docker compose exec -T app php tools/phpunit.phar -->
    <env name="SMOKE_BASE_URL" value="http://localhost"/>
  </php>
</phpunit>
