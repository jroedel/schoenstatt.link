    <div class="panel-body">
    <div><?= $this->markdown($object['adminNotes']);?>
    </div>
    </div> <!-- notes panel body -->
</div> <!-- notes panel -->
</div> <!-- notes column 12 -->
</div> <!-- notes row -->
