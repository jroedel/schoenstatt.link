<?php
use Books\View\Helper\FormatPublication;
/** @var \Laminas\View\Renderer\PhpRenderer $this */
/**
 * @var mixed[] $object
 */
$object = $this->object;
$showCover = ! isset($this->options) || ! isset($this->options['showCover']) || false !== $this->options['showCover'];
$panelTitle = (! isset($this->options) || ! isset($this->options['panelTitle']) || 'book-title-and-link' != $this->options['panelTitle']) ?
    'text' : 'book-title-and-link';
?>
<div class="row">
<?php if ($showCover) :?>
<div class="col-md-3">
    <?php if (file_exists(sprintf('public/covers/%s-400px.jpg', $object['publicationId']))) : ?>
        <a href="<?= $this->basePath() . sprintf("/covers/%s.jpg", $object['publicationId']); ?>">
        <img src="<?= $this->basePath() . sprintf("/covers/%s-400px.jpg", $object['publicationId']); ?>"
        class="img-responsive center-block" alt="<?= $this->escapeHtmlAttr($object['title']);?>"></a>
    <?php endif;?>
<p class="align-center"><?php //echo $this->escapeHtml(ucwords($object['condition']));?></p>
</div>
    <?php
    $infoPanelColumnLength = 9;
else :
    $infoPanelColumnLength = 12;
endif;?>
<div class="col-md-<?= $infoPanelColumnLength?>">
<div class="panel panel-default" id="infoPanel">
    <div class="panel-heading">
        <div class="row">
        <div class="col-xs-6">
            <h3 class="panel-title"><?php
            if ('book-title-and-link' === $panelTitle) {
                echo $this->formatEntity('publication', $object);
            } else {
                echo $this->escapeHtml($this->translate('Publication Info'));
            }?></h3>
        </div>

        <div class="col-xs-6">
            <?php if ($this->isAllowed($object['resourceId'], 'edit')) : ?>
                <span class="pull-right"><a class="btn btn-primary btn-sm" href="<?php
                    echo $this->url('publication-edit', ['sw_id' => $object['identifier']]);?>">
                    <?= $this->translate('Edit publication')?></a>
                </span>
            <?php endif;?>
        </div>
        </div>
    </div>
    <div class="panel-body"><div class="row">
    <div class="col-md-6">
          <p><strong><?= $this->translate('Author(s)');?>:</strong></p>
            <?php echo $this->formatEntity('publication', $object, ['display' => 'authors']);
            $otherEditions = array_merge($object['subEditions'], $object['translations']);
            if (! empty($otherEditions)) :?>
      <p><strong><?= $this->translate('Other editions');?>:</strong></p><?php
        foreach ($otherEditions as $subPublication) :?>
          <p><?php echo $this->formatEntity('publication', $subPublication);
            echo ' ';
            echo $this->formatEntity('publication', $subPublication, ['display' => FormatPublication::DISPLAY_EDITION]);?></p>
        <?php endforeach;
            endif;?>
    </div> <!-- info 1 column -->

    <div class="col-md-6">
        <p><strong><?= $this->translate('Language');?>:</strong> <?php
        if (! empty($object['inLanguage'])) {
            $languageNames = [];
            foreach ($object['inLanguage'] as $language) {
                $languageNames[] = $this->languageName($language);
            }
            echo implode(', ', $languageNames);
        }?></p>
        <?php if (! is_null($object['mainPublication'])) :?>
        <p><strong><?= $this->translate('Current publication');?>:</strong> <?php
        echo $this->formatEntity('publication', $object['mainPublication'], ['display' => FormatPublication::DISPLAY_DISAMBIGUATING_TITLE]);?></p>
        <?php endif;
        if (! is_null($object['translatedFromPublication'])) :?>
        <p><strong><?= $this->translate('Translated from');?>:</strong> <?php
        echo $this->formatEntity('publication', $object['translatedFromPublication']);?></p>
        <?php endif;
        echo $this->formatField('ISBN', $object['isbn'], ['displayOnlyIfNotNull' => true]);
        echo $this->formatField('Edition', $object['bookEdition'], ['displayOnlyIfNotNull' => true]);
        if (! empty($object['translatorsAll'])) {
            echo sprintf(
                '<p><strong>%s</strong>: %s</p>',
                $this->translate('Translator(s)'),
                $this->formatPublication('publication', $object, ['display' => FormatPublication::DISPLAY_TRANSLATORS])
            );
        }
        echo $this->formatField('Number of pages', $object['numberOfPages'], ['displayOnlyIfNotNull' => true]);
        echo $this->formatField('Date published', $object['datePublishedText'], ['displayOnlyIfNotNull' => true]);
        echo $this->formatField('Publisher', $object['publisher'], ['displayOnlyIfNotNull' => true]);
        echo $this->formatField('Publishing place', $object['publishingPlace'], ['displayOnlyIfNotNull' => true]);
//         echo $this->formatField('Publishing status', $object['publishingStatus'], ['displayOnlyIfNotNull' => true]);
        echo $this->formatField('Copyright year', $object['copyrightYear'], ['displayOnlyIfNotNull' => true]);
        echo $this->formatField('Book format', $object['bookFormatType'], ['displayOnlyIfNotNull' => true]);
        echo $this->formatField('Volume number', $object['volumeNumber'], ['displayOnlyIfNotNull' => true]);
        echo $this->formatField('Contained in', $object['containedIn'], ['displayOnlyIfNotNull' => true]);
        echo $this->formatField('Contained in ISBN', $object['containedInIsbn'], ['displayOnlyIfNotNull' => true]);
        echo $this->formatField('Genre', $object['genre'], ['displayOnlyIfNotNull' => true]);
        echo $this->formatField('Keywords', $object['keywords'], ['displayOnlyIfNotNull' => true, 'translateLabel' => false]);
        echo $this->formatField('Admin tags', $object['adminTags'], ['displayOnlyIfNotNull' => true, 'translateLabel' => false,
            'displayOnlyWithPermission' => 'route/publication-edit']);
        if (isset($object['dataSource']) || isset($object['dataSourceId']) || isset($object['mergedIntoPublicationId'])) {
            echo '<hr>';
        }
        echo $this->formatField('Data source', $object['dataSource'], ['displayOnlyIfNotNull' => true]);
        echo $this->formatField('Original ID within data source', $object['dataSourceId'], ['displayOnlyIfNotNull' => true]);
        if (isset($object['mergedIntoPublicationId'])) :
            $swIdBuilder = new \Schoenstatt\Filter\ToSchoenstattLinkIdentifier('publication');
            $mergedIntoUrl = $this->url(
                'publication',
                ['sw_id' => $swIdBuilder->filter($object['mergedIntoPublicationId'])]
            );?>
            <p><strong><?=$this->translate('Merged into')?></strong>:
                <a href="<?=$this->escapeHtmlAttr($mergedIntoUrl)?>">
                    <?=$this->escapeHtml($object['mergedIntoPublicationId'])?></a>
            </p>
        <?php elseif (isset($object['dataSource'])) :?>
            <p><a href="<?=$this->url(
                'publication-copy-to-main-corpus',
                ['sw_id' => $object['identifier'], 'slug' => $object['slug'] ?? null]
            )?>" class="btn btn-default">
                <?=$this->translate('Copy into main corpus')?>
            </a></p>
        <?php endif;
        foreach ($object['urls'] as $urlObject) :
            ?><p><?= $this->formatPublicationUrlObject($urlObject);?></p><?php
        endforeach;
        ?>
    </div> <!-- info 2 column -->
    </div></div> <!-- contact info panel body -->
</div> <!-- info 1 panel -->
</div> <!-- info 1 column -->
</div> <!-- Info row -->

