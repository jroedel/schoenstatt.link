<?php
/**
 * Confirmation page for copying a data-sourced publication into the main corpus.
 *
 * This page is the whole point of the change that added it: the copy used to happen on
 * the GET that now merely renders this. Cancelling is a plain link rather than a form
 * element, because a Cancel *button* inside a destructive form is exactly what made
 * SionModel\Form\DeleteEntityForm delete records for years.
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Books\Form\CopyToMainCorpusForm $form
 * @var array $entityObject
 * @var string $cancelUrl
 */
$title = $this->translate('Copy into main corpus');
$this->headTitle($title);

$name = $entityObject['title'] ?? $entityObject['identifier'] ?? '';
$form = $this->form;
$form->prepare();
?>
<h1><?= $this->escapeHtml($title) ?></h1>

<p class="lead"><?= $this->escapeHtml(sprintf(
    $this->translate('This will create a new publication in the main corpus from “%s”.'),
    $name
)) ?></p>

<p><?= $this->escapeHtml($this->translate(
    'The imported record it came from is left untouched. This cannot be undone automatically.'
)) ?></p>

<?php
if (isset($entityObject['dataSource'])) {
    echo '<p><strong>' . $this->escapeHtml($this->translate('Data source')) . '</strong>: '
        . $this->escapeHtml($entityObject['dataSource']) . '</p>';
}

echo $this->form()->openTag($form);
echo $this->formRow($form->get('security'));
echo $this->formSubmit($form->get('submit'));
echo '&nbsp;<a href="' . $this->escapeHtmlAttr($cancelUrl) . '" class="btn btn-default">'
    . $this->escapeHtml($this->translate('Cancel')) . '</a>';
echo $this->form()->closeTag();
