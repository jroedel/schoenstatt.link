<?php /** @var \Laminas\View\Renderer\PhpRenderer $this */
$headText = $this->entity['title'];
//setTranslatorEnabled(false) because the title is *data*: headTitle translates
//everything it holds when it renders, and a translator miss is what files a phrase.
//A corpus title is a filename (`1965-0613PRED.md`) or a bibliographic citation
//(`in: KENTENICH, Josef, Die Vision vom Berge Sion, Berg Sion ²1975, 49-93`), and
//219 of them had accumulated as permanent rows by 2026-05-30 — none translatable,
//and a "translation" of a filename would change a lookup string. Every other show
//page in this application already does this; only this one was missed, which is
//what the commented-out translate() line below was circling.
$this->headTitle()->setTranslatorEnabled(false);
$this->headTitle($headText);
$object = $this->entity;?>
<h1><?php echo $this->escapeHtml($headText);?></h1>

<p><i class="fa fa-calendar"></i> <?php echo $this->translate('Posted');?> <?php
if (isset($this->entity['createdOn'])) {
    echo $this->diffForHumans($this->entity['createdOn']);
}?></p>
<p><i class="fa fa-tags"></i> <?php echo $this->translate('Tags');?>: <?php
foreach ($object['tags'] as $tag) : ?>
<a href=""><span class="badge badge-info"><?php echo $this->escapeHtml($tag); //@todo translate this later?></span></a> 
<?php endforeach;?></p>
<hr>
<?php
if (isset($object['htmlText'])) {
    echo $object['htmlText'];
}?>
<hr>
    <!-- the comment box -->
<?php if (isset($this->commentForm)) {
    echo $this->partial('sion-model/comments/create', [
        'form' => $this->commentForm,
    ]);
}
echo $this->partial('sion-model/comments/comments-list', [
    'comments' => $this->comments,
]);?>

<div class="row"><div class="col-md-12">
<p><strong><?= $this->translate('Total views')?></strong>: <?= $this->visits['total']?> <strong><?= $this->translate('Views this month')?></strong>: <?= $this->visits['pastMonth']?></p>
</div></div>
<?php if (isset($this->schema)) {
    $schema = $this->schema;
    $thisUrl = $this->serverUrl() . $this->url(null, [], [], true);
    $schema->setProperty('url', $thisUrl);
    echo $schema->toScript();
}?>
