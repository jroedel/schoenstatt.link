<?php

/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Books\Form\TextForm $form
 *
 * blog/create matched and then 500'd for want of this file. The route is real and
 * guarded for blog_contributor, and the blog-post entity is fully configured —
 * `table_name => 'texts'`, `create_action_form => Books\Form\TextForm` — so a blog
 * post is a text with its own routes, and only the template was missing.
 *
 * The fields come from the *texts* partial, named in full rather than as the bare
 * 'fields-partial' its neighbours use. A bare name resolves against the calling
 * template's own directory (RelativeFallbackResolver), which would look for
 * books/blog/fields-partial.phtml and find nothing. Naming the texts one says the
 * true thing: both entities are edited through the same form, so a second copy of
 * that partial would be a copy to keep in sync for no reason.
 */

$headText = 'New blog post';
$this->headTitle($headText); ?>
<h1><?php echo $this->translate($headText);?></h1>

<?php
$form = $this->form;
$form->setAttribute('action', $this->url(null, [], [], true));
$form->prepare();
echo $this->form()->openTag($form);
echo $this->partial('books/texts/fields-partial', [
    'form' => $form,
]);
echo $this->form()->closeTag();
