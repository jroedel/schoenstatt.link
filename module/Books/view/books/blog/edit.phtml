<?php

/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Books\Form\TextForm $form
 *
 * See books/blog/create.phtml for why the fields partial is named in full: a blog
 * post is a text with its own routes, sharing Books\Form\TextForm and the texts
 * table, so the two edit through one partial.
 */

$headText = 'Edit blog post';
$this->headTitle($headText); ?>
<h1><?php echo $this->translate($headText);?></h1>

<?php
$form = $this->form;
$form->setAttribute('action', $this->url($this->routeName, [], [], true));
$form->prepare();
echo $this->form()->openTag($form);
echo $this->partial('books/texts/fields-partial', [
    'form' => $form,
]);
echo $this->form()->closeTag();
