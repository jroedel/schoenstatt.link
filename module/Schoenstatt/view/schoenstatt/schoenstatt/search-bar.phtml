<?php if ($this->centerOnPage) {
  echo " margin-top: 15%;";} ?>">
      <div class="col-md-6 col-md-offset-3 col-xs-12">
          <div id="custom-search-input">
           <?php echo $this->form()->openTag($form); ?>
