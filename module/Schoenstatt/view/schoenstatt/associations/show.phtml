<?php
$entity = $this->entity;
$this->headTitle()->setTranslatorEnabled(false);
$this->headTitle($entity['generationName']);?>
<h1><?php echo $this->escapeHtml($this->entity['generationName']);?></h1>

<div class="row">
<div class="col-md-12">
<div class="panel panel-default" id="infoPanel">
    <div class="panel-heading">
    	<div class="row">
    	<div class="col-xs-6">
        	<h3 class="panel-title"><?php echo $this->translate('Generation Info'); ?></h3>
        </div>

        <div class="col-xs-6">
            <?php if ($this->isAllowed('route/generations/generation/edit')): ?>
                <span class="pull-right"><a class="btn btn-primary btn-sm" href="<?php
                    echo $this->url('generations/generation/edit', array('generation_id' => $entity['generationId']));?>">
                    <?php echo $this->translate('Edit generation')?></a>
                </span>
            <?php elseif (false)://@todo $this->isAllowed('route/generations/generation/suggest')):?>
                <span class="pull-right"><a class="btn btn-default btn-sm" href="<?php
                    echo $this->url('courses/course/suggest', array('generation_id' => $entity['generationId']));?>">
                    <?php echo $this->translate('Suggest change')?></a>
                </span>
            <?php endif;?>
        </div>
        </div>
	</div>
    <div class="panel-body"><div class="row">
    <div class="col-md-6">
        <p><strong><?php echo $this->translate('Celebration date');?>:</strong>
      <?php if (!is_null($entity['celebrationDate'])) {
        echo $this->dateFormat($entity['celebrationDate'], IntlDateFormatter::LONG, IntlDateFormatter::NONE);
      }?></p>
      <p><strong><?php echo $this->translate('Foundation date');?>:</strong> <?php
        if (!is_null($entity['foundingDate'])) {
            echo $this->dateFormat($entity['foundingDate'], IntlDateFormatter::LONG, IntlDateFormatter::NONE);
        }?></p>
      <hr>
      <h4 class="text-center"><strong><?php echo $this->translate('Courses');?></strong></h4>
      <?php foreach ($entity['courses'] as $course) :?>
          <p><a href="#course<?php echo $course['courseId']?>"><?php
            echo $course['courseName'];?></a></p>
      <?php endforeach;?>
	</div> <!-- info 1 column -->

    <div class="col-md-6">
      <h4 class="text-center"><strong><?php echo $this->translate('Generation representatives');?></strong></h4>
    <?php foreach ($entity['roles'] as $role) : ?>
    <p>
    	<?php if ($role['assignmentPersonId']) :?>
    		<?php echo $this->formatPersonName($role['assignmentFirstName'], $role['assignmentLastName'], null,
    	    $role['assignmentPersonId'], $role['assignmentCountry']);
            echo ' '.$this->shortDateRange($role['assignmentStartDate'], $role['assignmentEndDate']);
    		if ($this->isAllowed('route/roles/assignment/edit')) : ?>
        		<a href="<?php
        		echo $this->url('roles/assignment/edit', array('assignment_id' => $role['assignmentId'],
                    'action' => 'edit'));?>">
    			<span class="glyphicon glyphicon-pencil" aria-hidden="true"></span></a>
    		<?php endif;?>
    	<?php endif;?>
    </p>
    <?php endforeach;?>
    <?php if (isset($entity['roles'][0]) && $entity['roles'][0]['roleId'] && $this->isAllowed('route/roles/create')): ?>
        <p><a class="btn btn-default btn-sm" href="<?php
            echo $this->url('roles/create', [],
                array('query' => array('roleId' => $entity['roles'][0]['roleId'])));?>">
            <span class="glyphicon glyphicon-plus">&nbsp;</span><?php echo $this->translate('Add generation representative')?></a>
        </p>
    <?php endif;?>
	</div> <!-- info 2 column -->
    </div></div> <!-- contact info panel body -->
</div> <!-- course info 1 panel -->
</div><!-- info 1 column -->
</div> <!-- Info row -->

<?php if (count($entity['idealLanguages']) > 0) :?>
<div class="row"> <!-- ideal row -->
<div class="col-md-12">
<div class="panel panel-default" id="generationIdealPanel">
    <div class="panel-heading">
    	<div class="row">
    	<div class="col-xs-8">
        	<h3 class="panel-title"><?php echo $this->translate('Ideal Statement');?>
        </h3>
        </div>
        <div class="col-xs-4"><div class="pull-right">
        	<?php
        	$selectedLanguage = $this->languageChooser(array_keys($entity['idealLanguages']));
        	$firstSelector = true;
        	foreach ($entity['idealLanguages'] as $language => $key) :
                $divId = $language.'IdealGeneration'.$entity['generationId'];
                if ($language === $selectedLanguage) {
                    $isSelected = true;
                } else {
                    $isSelected = false;
                }
                if (!$firstSelector) {
                    echo '|';
                } else {
                    $firstSelector = false;
                }?>
        		<a data-toggle ="collapse"
		        data-target="#<?php echo $divId;?>"
		        aria-expanded="<?php echo $isSelected ? 'true' : 'false';?>"
		        aria-controls="<?php echo $divId;?>"
		        aria-expanded="<?php echo $isSelected ? 'true' : 'false';?>">
        		<?php echo strtoupper($language);?></a>
        	<?php endforeach;?></div>
        </div>

        </div>
	</div>
	<div class="panel-body">
	<?php
	$jsScript = '';
    foreach ($entity['idealLanguages'] as $language => $key) {
        $divId = $language.'IdealGeneration'.$entity['generationId'];
        if ($language == $selectedLanguage) {
            echo '<div class="collapse in" id="'.$divId.'" aria-expanded="true">';
        } else {
            echo '<div class="collapse" id="'.$divId.'" aria-expanded="false">';
        }
        echo $this->markdown($entity[$key]);
        echo '</div>';
	    $jsScript .= <<<JS
$("#$divId").on('show.bs.collapse', function (e) {
  $("#$divId").siblings().collapse('hide');
})

JS;
    }
$this->inlineScript()->captureStart();
echo <<<JS
$(function () {
$jsScript
});
JS;
$this->inlineScript()->captureEnd();
    ?>
	</div>
</div> <!-- ideal panel -->
</div> <!-- ideal column -->
</div> <!-- ideal row -->
<?php endif;?>

