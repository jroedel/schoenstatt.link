    	<h3 class="panel-title"><?php echo $this->translate('Association Info'); ?></h3>
	</div>
    <div class="panel-body"><div class="row">
    <div class="col-md-6">
        <p><strong><?php echo $this->translate('Foundation date');?>:</strong>
        <?php if (!is_null($entity['foundationDate'])) {
        echo $this->dateFormat($entity['foundationDate'], IntlDateFormatter::LONG, IntlDateFormatter::NONE);
        }?></p>
		<?php if (!is_null($entity['suppressionDate'])) :?>
      		<p><strong><?php echo $this->translate('Suppression date');?>:</strong> <?php
                echo $this->dateFormat($entity['suppressionDate'], IntlDateFormatter::LONG, IntlDateFormatter::NONE);
            ?></p>
		<?php endif;?>
	</div> <!-- info 1 column -->

    <div class="col-md-6">
      <h4 class="text-center"><strong><?php echo $this->translate('Association representatives');?></strong></h4>
    <?php foreach ($entity['roles'] as $role) : ?>
