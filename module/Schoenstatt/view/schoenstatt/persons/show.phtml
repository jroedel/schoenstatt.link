            endif;?>
        </div>
        </div>
	</div>
    <div class="panel-body">

<div class="row"> <!-- private info panel row -->
<div class="col-md-6"> <!-- private facts column -->
<!-- Nationalities, birth city -->
<p><strong><?php echo $this->translate('Nationality'); ?>:</strong>
<?php
if (is_array($entity['nationalities'])) {
$printNats = [];
