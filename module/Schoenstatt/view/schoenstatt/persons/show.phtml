    $printNats[] = $this->countryName($nat, true, CountryName::COUNTRY_NAME_COMMON);
}}
echo implode(', ', $printNats);
?></p>
<?php if (!empty($entity['adminTags'])) :?>
<p><strong><?php echo $this->translate('Admin tags'); ?>:</strong> <?php
$adminTagFormat = '<span class="label label-default">%s</span>';
$formattedAdminTags = array();
foreach ($entity['adminTags'] as $value) {
    $formattedAdminTags[] = sprintf($adminTagFormat, $this->escapeHtml($value));
}
echo implode(' ', $formattedAdminTags);?>
<?php endif;?>
