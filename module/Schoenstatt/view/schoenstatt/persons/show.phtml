    }?></p>
    <?php if (is_object($entity['deathDate'])): ?>
        <p><strong><?php echo $this->translate('Passed away on'); ?>:</strong> <?php
        echo $this->dateFormat($entity['deathDate'], IntlDateFormatter::MEDIUM, IntlDateFormatter::NONE);?></p>
    <?php endif;?>
    <p><strong><?php echo $this->translate('Nameday'); ?>: </strong> <?php
