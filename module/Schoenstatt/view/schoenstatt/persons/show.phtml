    $pageTitle .= $title . ' ';
    $pageHeader .= $title . ' ';
}
$pageTitle .= $this->escapeHtml($entity['fullFriendlyName']);
$pageHeader .= $this->escapeHtml($entity['fullName']);
$this->headTitle()->setTranslatorEnabled(false);
$this->headTitle($pageTitle);
?>
