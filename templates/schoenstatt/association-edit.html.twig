{#
  The association (and shrine) edit form — the Twig counterpart of
  module/Schoenstatt/view/schoenstatt/associations/edit.phtml and its
  fields-partial.phtml, which still render this page on production.

  Field order and grouping are copied from that partial deliberately and should be
  changed in both or neither: the two renderings are live at the same time on
  different front controllers, and a moderator who edits a shrine through one and
  then the other should not see the form rearrange itself.

  The two hand-built groups at the top are the partial's, not a row helper's — it
  packs the name field together with its two checkboxes, and the internal name with
  three more, rather than giving each its own row. That is why form_label/
  form_element/help_block appear individually here and everything below is a plain
  form_row.

  **The field rows live in `schoenstatt/_association-fields.html.twig` now**, shared with the create
  form so that a field cannot be added to one surface and quietly forgotten on the
  other. What stays in this file is what edit.phtml keeps outside its own partial —
  which is not the same set for every entity, and is the detail worth checking before
  moving anything across the boundary.
#}
{% extends 'layout.html.twig' %}

{#
  The two assets fields-partial.phtml appends through headLink()/headScript(). The
  script filename carries the primary language, because the bundle contains the
  jQuery-validate locale strings.
#}
{% block page_stylesheets %}
        <link href="/css/gen-selectize-markdown-jquery-ui.css" media="screen" rel="stylesheet" type="text/css">
{% endblock %}

{% block page_scripts %}
        <script src="/js/gen-validate-selectize-markdown-{{ current_language() }}.js"></script>
{% endblock %}

{% block content %}
<h1>{{ translate('Edit Association') }}</h1>

{{ form_open(form, form_action) }}
{{ include('schoenstatt/_association-fields.html.twig') }}
{{ form_submit(form.get('submit')) }}
{{ form_close() }}
{% endblock %}

{% block inline_scripts %}
{#
  selectize on the free-text label selects, and on country. `create: true` on the
  six label fields is the UI half of the decision recorded in
  App\Schoenstatt\Association\AssociationInputFilterSpec: those fields have no
  InArray precisely because a moderator is expected to type a label the list does
  not have, and 12 stored values already are.
#}
<script nonce="{{ csp_nonce() }}">
$(function () {
$("select[name='country']").selectize({
    create: false,
    sortField: 'text'
});
$("select[name='phone1Label']").selectize({
    create: true,
    sortField: 'text'
});
$("select[name='phone2Label']").selectize({
    create: true,
    sortField: 'text'
});
$("select[name='phone3Label']").selectize({
    create: true,
    sortField: 'text'
});
$("select[name='url1Label']").selectize({
    create: true,
    sortField: 'text'
});
$("select[name='url2Label']").selectize({
    create: true,
    sortField: 'text'
});
$("select[name='url3Label']").selectize({
    create: true,
    sortField: 'text'
});
});
</script>
{% endblock %}
