{#
  How an association or a person is written out in a link.

  Under laminas this is Schoenstatt\View\Helper\FormatAssociation and
  FormatPerson, reached through SionModel's `formatEntity` dispatcher. None of the
  three can be called from here: each ends in `$this->view->url()`, which wants a
  RouteMatch off the MvcEvent a Symfony-served route does not have. So the
  *decisions* those helpers make are reproduced here — with their defaults, in their
  order, producing their markup — against laminas_path() instead.

  Defaults taken from FormatAssociation::__invoke() with no options, which is how
  both shrine tables call it: display=name, so showFlag, displayAsLink and
  editPencil are all on and showLabel is off.
#}

{%- macro association(entity) -%}
    {%- set locale = current_locale() -%}
    {%- if entity.country %}{{ flag(entity.country) }}&nbsp;{% endif -%}
    {%- set name = entity.nameByLocale[locale] -%}
    {%- if is_allowed('route/association') -%}
        <a href="{{ laminas_path('association', {'sw_id': entity.identifier, 'slug': entity.slugByLocale[locale]}) }}">{{ name }}</a>
    {%- else -%}
        {{- name -}}
    {%- endif -%}
    {{- edit_pencil('association', entity.identifier) -}}
{%- endmacro -%}

{#
  display=kind, whose defaults are the mirror image: no link, no pencil, no flag
  needed. The label comes from Schoenstatt\Service\AssociationKindsService, which
  has already translated it — hence no translate() here, exactly as the helper
  comments say.
#}
{%- macro association_kind(entity, kind_labels) -%}
    {{- kind_labels[entity.kind] is defined ? kind_labels[entity.kind] : translate(entity.kind) -}}
{%- endmacro -%}

{#
  FormatPerson::__invoke() with no options: last-name-first, title shown, flag
  shown, linked, edit pencil on, labels off. The leading guard is its guard —
  a person with no name at all renders as nothing rather than as an empty link.
#}
{%- macro person(person) -%}
    {%- if person.personId and person.personId != '' and (person.firstName is not null or person.lastName is not null) -%}
        {%- if person.country %}{{ flag(person.country) }}&nbsp;{% endif -%}
        {%- set first = person.title ? translate(person.title) ~ ' ' ~ person.firstName : person.firstName -%}
        {%- set name = person.lastName ? person.lastName ~ ', ' ~ first : first -%}
        <a href="{{ laminas_path('persons/person', {'person_id': person.personId}) }}">{{ name }}</a>
        {%- if person.deathDate %} (✝{{ person.deathDate|date('Y') }}){% endif -%}
        {{- edit_pencil('person', person.personId) -}}
    {%- endif -%}
{%- endmacro -%}
