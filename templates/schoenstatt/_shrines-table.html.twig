{#
  module/Schoenstatt/view/schoenstatt/associations/shrines-table.phtml — the
  data-maintainer's table, shown only to whoever may edit an association. Expects
  `objects` and `kind_labels`.

  One faithful reproduction of something that looks like a mistake, kept because
  changing behaviour was not the job here: "Opening hours?" tests
  `openingHoursJson`, a key the association projection does not contain (it is
  `openingHoursSpecificationJson`), so the column really only reflects
  `openingHoursHuman`. Written up in the port's report.
#}
{% import 'schoenstatt/_entity-format.html.twig' as format %}
{% set yes = translate('Yup!') %}
{% set no = translate('Nope :-(') %}
<!-- Table -->
<div class="table-responsive">
<table class="table">
<tr>
    <th>{{ translate('Shrine') }}</th>
    <th>{{ translate('Website') }}</th>
    <th>{{ translate('Photo?') }}</th>
    <th>{{ translate('Opening hours?') }}</th>
    <th>{{ translate('Events?') }}</th>
    <th>{{ translate('Name translated?') }}</th>
</tr>
{% for entity in objects %}
<tr>
    <td>{{ format.association(entity) }}</td>
    {#- the first url that is not the Google Maps pin, and only that one -#}
    {% set web_url = entity.urls|filter(url => url.label != 'Map')|first %}
    <td>{% if web_url is iterable %}{{ url_object_link(web_url) }}{% endif %}</td>
    <td>{{ entity.photos ? yes : no }}</td>
    <td>{{ entity.openingHoursJson is defined or entity.openingHoursHuman is not null ? yes : no }}</td>
    <td>{{ entity.eventsJson is not null or entity.eventsHuman is not null ? yes : no }}</td>
    <td>{{ entity.hasTranslationCount }}/{{ entity.needTranslationCount }}
    {%- if is_allowed('route/jtranslate/phrase/edit') -%}
        {%- for phraseId, phraseText in entity.translationPhrases -%}
            <a href="{{ laminas_path('jtranslate/phrase/edit', {'phrase_id': phraseId}) }}"><span class="glyphicon glyphicon-pencil" aria-hidden="true"></span></a>
        {%- endfor -%}
    {%- endif -%}
    </td>
</tr>
{% endfor %}
</table>
</div>
