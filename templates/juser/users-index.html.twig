{#
  module/JUser/view/j-user/users/index.phtml — every account, its roles, and the person
  record it points at.

  Two links per row, each behind its own `is_allowed()`, on a page whose own guard is
  already `administrator`. Reproduced rather than simplified: the three guard entries in
  config/autoload/juser.global.php are independent, so narrowing `juser/user/api-tokens`
  to a tighter role is a supported change and the crown has to vanish when it happens.

  `&nbsp;` before each link, and `&times;` for an inactive account, are literal entities in
  the .phtml — written literally here for the same reason. The person cell goes through the
  dispatcher macro because laminas formats a person with a helper reproduced as one; JUser
  passes `['editPencil' => true]`, which FormatPerson does not read (it reads
  `displayEditPencil`), so the key has never done anything and the default — pencil on — is
  what both sides render.
#}
{% extends 'layout.html.twig' %}

{% import 'schoenstatt/_entity-format.html.twig' as fmt %}

{% block content %}
<h1>{{ translate('User Management') }}</h1>
<p><a href="{{ laminas_path('juser/create') }}">{{ translate('Add new user') }}</a> |
  <a href="{{ laminas_path('juser/create-role') }}">{{ translate('Add new role') }}</a></p>

<table class="table">
<tr>
    <th>{{ translate('Username') }}</th>
    <th>{{ translate('Email') }}</th>
    <th>{{ translate('Display Name') }}</th>
    <th>{{ translate('Active') }}</th>
    <th>{{ translate('Roles') }}</th>
    <th>{{ translate('Person') }}</th>
</tr>
{% for user in users %}
<tr>
    <td>{{ user.username }}{% if is_allowed('route/juser/user/edit') %}&nbsp;<a href="{{ laminas_path('juser/user/edit', {'user_id': user.userId}) }}"><span class="glyphicon glyphicon-pencil" aria-hidden="true"></span></a>{% endif %}{% if is_allowed('route/juser/user/api-tokens') %}&nbsp;<a href="{{ laminas_path('juser/user/api-tokens', {'user_id': user.userId}) }}" title="{{ translate('API tokens') }}"><span class="glyphicon glyphicon-king" aria-hidden="true"></span></a>{% endif %}</td>
    <td>{{ user.email }}</td>
    <td>{{ user.displayName }}</td>
    <td>{% if user.active %}✓{% else %}&times;{% endif %}</td>
    <td>{% for role in user.roles %}{% if not loop.first %}, {% endif %}{{ role.name }}{% endfor %}</td>
    <td>{% if persons and user.personId is not null and persons[user.personId] is defined %}{{ fmt.person(persons[user.personId]) }}{% endif %}</td>
</tr>
{% endfor %}
</table>
{% endblock %}
