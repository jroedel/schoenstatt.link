{#
  module/Books/view/books/library-imports/show.phtml plus its import-stats partial, which
  is three lines and rendered from exactly two places — inlined here and repeated in the
  edit page, which stays on laminas.
#}
{% extends 'layout.html.twig' %}

{% block content %}
<h1>{{ translate('Import details') }}</h1>
<p><strong>{{ translate('Import name') }}:</strong> {{ entity.name }}</p>
<p><strong>{{ translate('Description') }}:</strong> {{ entity.description }}</p>
<p><strong>{{ translate('File path') }}:</strong> {{ entity.filePath }}</p>
<p><strong>{{ translate('Worksheet') }}:</strong> {{ entity.worksheet }}</p>

<p><strong>{{ translate('Complete import') }}:</strong> {{ entity.isCompleteImport ? translate('Yes') : translate('No') }}</p>

<p><strong>{{ translate('Import started') }}:</strong> {{ full_datetime(entity.createdOn) }}</p>
<p><strong>{{ translate('Last updated') }}:</strong> {{ full_datetime(entity.updatedOn) }}</p>

<p><strong>{{ translate('Books created') }}:</strong> {{ entity.booksCreated }}</p>
<p><strong>{{ translate('Books updated') }}:</strong> {{ entity.booksUpdated }}</p>
<p><strong>{{ translate('Books inactivated') }}:</strong> {{ entity.booksInactivated }}</p>

<a class="btn btn-primary" href="{{ laminas_path('libraries/library/admin', {'library_id': entity.libraryId}) }}">{{ translate('Return to library') }}</a>
{% endblock %}
