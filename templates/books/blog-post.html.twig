{#
  module/Books/view/books/blog/show.phtml.

  `page_title` and the breadcrumb are set here rather than passed in, because both are
  the post's title *translated* — headTitle() gets translate($title) and laminas'
  navigation helper translates the crumb label — and translate() only knows the page's
  text domain from inside the render.

  The comment box is a comment and nothing more: `blog-post` has no comment predicate
  (the `comment-comments-text` predicate names `text`, not `blog-post`), so
  SionController::showAction() leaves both $commentForm and $comments unset and the two
  partials render nothing. That is why this page could be ported at all while the form
  layer does not exist — /music's composition pages, whose entity *is* commentable,
  cannot be.
#}
{% extends 'layout.html.twig' %}
{% import 'books/_blog-front-matter.html.twig' as blog %}

{% set page_title = translate(entity.title) %}
{# untranslated: the breadcrumbs partial prints navigation labels verbatim #}
{% set breadcrumbs = [
    {'label': 'Blog', 'href': blog_url},
    {'label': entity.title, 'href': post_url},
] %}

{% block content %}
<h1>{{ translate(entity.title) }}</h1>
{{ blog.front_matter(entity) }}
<hr>
{{ translate(entity.markdownText)|markdown_safe }}
<hr>
    <!-- the comment box -->

{{ schema }}
{% endblock %}
