# secrets.env — every credential this application has, in one file. This is the
# committed template; config.sh copies it to secrets.env (gitignored, mode 0600).
# Replace every TODO there, never here.
#
# THE VAULT COPY IS THE ONE THAT COUNTS. Keep secrets.env in the password vault and
# update the vault the same day the file changes. On a new machine, take it from the
# vault, save it at the repository root and `chmod 600 secrets.env`.
#
# Two sections, and where each goes is the point of the split:
#
#   DEPLOY_*  read by tools/deploy.sh and the other deploy tools on this machine.
#             `make gh-secrets` bundles them, never an APP_* name, into the one
#             GitHub secret DEPLOY_SECRETS_ENV that .github/workflows/deploy.yml
#             reads on a runner.
#   APP_*     production's config/autoload/local.php. `make prod-config` renders it
#             from config/autoload/local.production.php.dist and installs it on the
#             server. Never sent to GitHub.
#
# PARSED, NEVER SOURCED (tools/secrets-env.sh): NAME=value, NAME='value' or
# NAME="value", one per line. A quoted value is taken exactly; nothing is expanded.
#
# The DEPLOY_DB_* credentials never reach the server: they are used only through
# an SSH tunnel opened for the duration of a migration, which is the whole reason
# they can be full-DDL.

# --- where -------------------------------------------------------------------

# Your own shell account on port 222. Since phploy was retired there is only one
# identity: the restricted SFTP account on port 22 is no longer used by anything.
# This account is also the user web PHP runs as, so a release tree it writes is
# writable by the web server — which is why nothing here chmods anything.
DEPLOY_SSH_USER=userTODO
DEPLOY_SSH_HOST=your-server.com
DEPLOY_SSH_PORT=222

# Application directory relative to the account's home, e.g.
# public_html/schoenstatt.link. releases/ and shared/ are created inside it.
DEPLOY_APP_PATH=public_html/TODO

DEPLOY_BASE_URL=https://schoenstatt.link

# --- keys --------------------------------------------------------------------

# The maintenance key, and THIS FILE IS ITS SOURCE. tools/deploy.sh and
# tools/smoke-prod.sh send it; `make prod-config` renders it into the server's
# `sion_model.api_keys`, which is what App\Http\MaintenanceKey checks; `make
# gh-secrets` puts it in the bundle the runner deploys with. A copy that falls
# behind fails silently: the next deploy from Actions sends the old key, its
# post-deploy cache flush answers 401, and the release serves stale code out of a
# warm OPcache.
#
# TO ROTATE, widening before narrowing so there is never a moment neither works:
#
#     openssl rand -base64 32 | tr -d '=+/'   # generate
#     # move the current key to DEPLOY_API_KEY_PREVIOUS, paste the new one below
#     make prod-config                        # the server accepts both; checked live
#     make gh-secrets                         # the runner sends the new one
#     # empty DEPLOY_API_KEY_PREVIOUS
#     make prod-config                        # only the new key remains
#
# `+`, `/` and `=` are stripped because the value travels through an HTTP header
# and a PHP string literal; base64 minus those three is still 32 bytes of urandom
# and needs no quoting anywhere. It travels in an X-Api-Key header, never a query
# string — a query string is written to the server's access log.
DEPLOY_API_KEY=xxxxTODOxxxx
# Empty except mid-rotation. Rendered into `sion_model.api_keys` beside the key
# above; never sent to GitHub.
DEPLOY_API_KEY_PREVIOUS=

# --- the CI runner -----------------------------------------------------------

# The deploy key the GitHub runner uses, base64 on one line — its own key, not
# yours, so revoking CD never means rotating the key you use daily. No passphrase:
# there is no agent on a runner. Its public half is in the server's
# ~/.ssh/authorized_keys. `make secrets-init` fills this from
# ~/.ssh/schoenstatt-deploy-ci; by hand:
#
#     base64 -w0 < ~/.ssh/schoenstatt-deploy-ci
DEPLOY_CI_SSH_KEY_B64=TODO

# The server's host key as known_hosts lines, base64 on one line. Pinned, not
# discovered: the runner refuses a host whose key is not this one. `make
# secrets-init` takes it with ssh-keyscan and checks it against your own
# ~/.ssh/known_hosts before writing it.
DEPLOY_KNOWN_HOSTS_B64=TODO

# --- behaviour ---------------------------------------------------------------

# How many release directories to keep. The live one and the one a rollback
# would reach for are never pruned regardless of this number.
DEPLOY_KEEP_RELEASES=5

# Optional. Set to 'sl_symfony_canary=1' (or =0) to have the post-deploy smoke
# run exercise the front-controller override as well — about 35 extra checks.
# The value is a switch, not data: smoke-prod.sh names both cookies itself and
# probes which kernel is the site default, so the same setting keeps working
# across a flip instead of failing loudly on the one day it must be believed.
DEPLOY_CANARY_COOKIE=

# --- database (migrations) ---------------------------------------------------

# Full-DDL credentials for the production database, used by tools/deploy.sh
# over an SSH tunnel to the server's own 127.0.0.1:3306. Left blank, the deploy
# reports migrations as unmanaged and a person runs tools/migrate.sh.
DEPLOY_DB_NAME=ourlink_db1
DEPLOY_DB_USER=TODO
DEPLOY_DB_PASS=TODO

# Local port for the tunnel. Anything free; it never reaches the server. If it
# is taken, the runner moves to the next free port and says so — it does not
# quietly use whatever is already listening there, which on one machine was an
# unrelated WordPress container's MariaDB.
DEPLOY_DB_TUNNEL_PORT=13306

# Retention for the table snapshots taken before each migration (on the server
# in shared/migration-snapshots/ for production, data/deploy/backups/ for the
# capsule). Every deletion is named on screen.
#
# The first two are floors: a snapshot survives if it is among the last N runs
# for its environment OR younger than the day limit, so a quiet month cannot
# leave you with nothing and a busy afternoon cannot age out yesterday's.
#
# The third is a ceiling and beats both. The run floor protects by POSITION and
# has no time limit of its own, so without this the last few snapshots are kept
# until that many further migrations happen — which, across the month of 2026
# with no migrations at all, was never. A snapshot of data deliberately erased
# must not have its lifetime decided by whether anyone writes another migration.
#
# MAX must be greater than KEEP_DAYS; set it empty to disable the ceiling and
# get the old unbounded behaviour back.
DEPLOY_KEEP_BACKUP_RUNS=3
DEPLOY_KEEP_BACKUP_DAYS=7
DEPLOY_MAX_BACKUP_DAYS=30

# The two stores the deploy prunes in its housekeeping step, both of which grew
# without any limit until 2026-09-24.
#
# htaccess-backups: one copy of public/.htaccess per deploy. Tiny, so this is
# clutter rather than a privacy question; the last ten answer "what did it look
# like before".
DEPLOY_KEEP_HTACCESS=10
# exceptions: one directory per distinct failure, aged on <fp>/last.txt — the
# last time that failure actually happened. Longer than a snapshot's ceiling on
# purpose: this is diagnostic, it holds only a truncated /24, and a rare fault
# needs a wider window than a backup does. Deleting a fingerprint re-arms its
# notification threshold, so one that returns after this long is reported as new.
DEPLOY_KEEP_EXCEPTION_DAYS=90


# =============================================================================
# APP — production's config/autoload/local.php
# =============================================================================
#
# Rendered by `make prod-config` from config/autoload/local.production.php.dist on
# origin/master: that template is the file's shape, this section its values. Run
# `make prod-config-diff` first; it names every key that would change and prints no
# value. To fill this section from what the server holds now:
#
#     make prod-config-import       # writes var/secrets.imported.env, mode 0600
#
# A comma-separated name (…_KEYS) becomes a list. Settings that are not secret —
# the driver, the SMTP port and encryption, the error-display and cookie flags —
# are written in the template, not here.

# The application's own database account: SELECT/INSERT/UPDATE/DELETE, not the
# DDL account above. tools/migrate.sh reads it back from the server for snapshots.
APP_DB_HOST=localhost
APP_DB_NAME=ourlink_db1
APP_DB_USER=TODO
APP_DB_PASSWORD=TODO

# The mailbox the application sends from (smtp_options).
APP_SMTP_HOST=mail.your-server.de
APP_SMTP_USER=webmaster@schoenstatt.link
APP_SMTP_PASSWORD=TODO

# The Google Apps Script web app that lists a library's Drive files
# (books.files_api_url / files_api_key, read by Books\Service\DriveGateway).
APP_DRIVE_URL=https://script.google.com/macros/s/TODO/exec
APP_DRIVE_KEY=TODO

# schoenstatt.api_keys: the keys LibraryNoticesController accepts. Comma-separated.
APP_LIBRARY_API_KEYS=TODO

# ApiRequest.jwtAuth.cypherKey: signs and verifies /api/v3 tokens. Changing it
# invalidates every token issued.
APP_JWT_KEY=TODO
