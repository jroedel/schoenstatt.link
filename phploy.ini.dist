; phploy deploy config — committed template. config.sh copies this to
; phploy.ini (gitignored); replace every TODO there, never here. The SFTP
; password goes in .phploy (copied from .phploy.dist), not in this file.
; NOTE: If non-alphanumeric characters are present, enclose the value in quotes.
;
; The two keyed hooks below both take the same value: any entry from the
; server's sion_model.api_keys config. The cache hooks need no key at all —
; they run on the server, where bin/console reads it from the app's own config.
; Keys travel in an X-Api-Key header, never a query string: a query string is
; written to the server's access log and kept in shell history.
[production]
    scheme = sftp
    user = userTODO
    host = your-server.com
    ; app directory relative to the SFTP root, e.g. public_html/schoenstatt.link
    path = /
    port = 22
    exclude[] = 'phploy.ini'
    exclude[] = 'phploy.log'
    purge[] = "data/config/"

    ; sshUserTODO is YOUR shell-capable account (port 222), distinct from
    ; the restricted SFTP-only deploy user above — a phploy vulnerability
    ; can move files but never exec.
    pre-deploy[] = "ssh -p 222 sshUserTODO@your-server.com 'cd public_html/schoenstatt.link && mkdir -p data/htaccess-backups && cp -a public/.htaccess data/htaccess-backups/htaccess-$(date +%Y%m%d-%H%M%S)'"

    ; order matters:
    post-deploy[] = "bash tools/deploy-submodules.sh"
    ; composer install comes first because bin/console needs symfony/console in
    ; vendor/. cache:clear-config then re-clears the merged config a visitor may
    ; have re-cached from the half-deployed tree since phploy's purge[], and
    ; cache:flush-persistent drops the APCu segment. That one has to be an HTTP
    ; request (which the command makes for us): an APCu segment belongs to the
    ; SAPI that created it, so no CLI process can flush the web server's cache.
    ; Running it over ssh keeps the maintenance key on the server, out of this
    ; file entirely.
    post-deploy[] = "ssh -t -p 222 sshUserTODO@your-server.com 'cd public_html/schoenstatt.link && php composer.phar install --no-dev --no-interaction --optimize-autoloader && php bin/console cache:clear-config && php bin/console cache:flush-persistent'"
    ; Rebuild the compiled *.lang.php catalogs from the database.
    ;
    ; They are gitignored build output, so phploy never uploads them: the copies
    ; on the server are whatever the application last wrote for itself, which
    ; happens only when a translator saves a phrase or the discovery path finds
    ; one that already had a translation elsewhere. Nothing else has ever
    ; rebuilt them, which is how they drifted far enough from the database to be
    ; worth untracking in the first place. A deploy that changes phrases — or a
    ; database migration that removes some — leaves them stale until this runs.
    ;
    ; Runs last, and cannot fail the deploy. A stale catalog only means some
    ; strings render in English; the translations themselves are safe in the
    ; database and the next run picks them up. Aborting a deploy over that, or
    ; skipping the hooks after it, would be the wrong trade — so the exit status
    ; is swallowed and the failure is printed instead.
    ;
    ; It writes into the deployed tree, as the ssh account rather than as the
    ; web-server user. That is safe because each catalog is written to a
    ; temporary file and renamed into place, and rename() needs write permission
    ; on the *directory*, not on the existing file — so the web server can still
    ; replace a catalog this hook created. Do not "simplify" that write.
    post-deploy[] = "ssh -p 222 sshUserTODO@your-server.com 'cd public_html/schoenstatt.link && php bin/console jtranslate:export-catalogs' || echo 'WARNING: jtranslate:export-catalogs failed. Translations are safe in the database, but the *.lang.php catalogs on the server are stale, so some strings will render in English. Re-run it by hand.'"
    post-deploy[] = "wget https://schoenstatt.link/en/associations/do-work --header='X-Api-Key: xxxxTODOxxxx' --spider --quiet"
    post-deploy[] = "git tag -f deploy/$(date +%Y%m%d-%H%M)"
    post-deploy[] = "SMOKE_PROD_CACHE_KEY=xxxxTODOxxxx bash tools/smoke-prod.sh"
    logger = on